// Configured by app/CMakeLists.txt into the build tree; this file is a template.
#include <windows.h>

IDI_NEXPDF_ICON ICON DISCARDABLE "@NEXPDF_ICON_PATH@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "nexPDF"
            VALUE "FileDescription", "nexPDF PDF viewer and editor"
            VALUE "FileVersion", "@NEXPDF_VERSION@"
            VALUE "InternalName", "nexPDF"
            VALUE "LegalCopyright", "AGPL-3.0-or-later"
            VALUE "OriginalFilename", "nexPDF.exe"
            VALUE "ProductName", "nexPDF"
            VALUE "ProductVersion", "@NEXPDF_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
